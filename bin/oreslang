#!/bin/sh
# Preserve the "oreslang test" command without depending on Python.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ $# -gt 0 ] && [ "$1" = "test" ]; then
    shift
    exec "$here/oreslang-test" "$@"
fi
core=${ORESLANG_BIN:-oreslang-core}
self="$here/oreslang"
resolved=$(command -v "$core" 2>/dev/null || true)
if [ "$resolved" = "$self" ] || [ "$core" = "$self" ]; then
    echo "ORESLANG_BIN points to the test wrapper" >&2
    exit 2
fi
exec "$core" "$@"
