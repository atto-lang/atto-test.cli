#!/bin/sh
# The official implementation is the Rust binary.
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "${ORESLANG_TEST_BIN:-}" ]; then
    exec "$ORESLANG_TEST_BIN" "$@"
elif [ -x "$base/target/release/oreslang-test" ]; then
    exec "$base/target/release/oreslang-test" "$@"
elif [ -x "$base/target/debug/oreslang-test" ]; then
    exec "$base/target/debug/oreslang-test" "$@"
else
    echo "oreslang-test has not been built; run 'cargo build --release' in $base" >&2
    exit 2
fi
